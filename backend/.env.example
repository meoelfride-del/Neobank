# Serveur
PORT=4000
SOCKET_PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL (base locale de développement dédiée)
DATABASE_URL=postgresql://neobank:mot_de_passe@localhost:5432/neobank

# JWT
JWT_SECRET=change_this_super_secret_key_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_other_secret_key_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Chiffrement AES-256-GCM (32 octets en hex = 64 caractères)
ENCRYPTION_KEY=generate_your_own_key

# OTP / 2FA
OTP_ISSUER=NeoBank

# Optionnel : cle distincte pour les photos KYC. Vide = utilise ENCRYPTION_KEY.
# Conserver cette cle stable : sa rotation requiert une migration des documents.
KYC_ENCRYPTION_KEY=

# SMS transactionnels Twilio (désactivés tant que les accès ne sont pas configurés)
SMS_ENABLED=false
SMS_PROVIDER=textbee
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Alternative à Messaging Service : numéro Twilio ou expéditeur autorisé
TWILIO_FROM=
